# Copia este archivo como `.env` (local) o define estas variables en Vercel.
# Todas son opcionales; los canales vacíos simplemente no se muestran.

# WhatsApp comercial, solo dígitos con indicativo de país (p. ej. 57XXXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Correo que recibe las solicitudes
VITE_CONTACT_EMAIL=

# Endpoint opcional para recibir el formulario por POST (Formspree, Getform, webhook...)
VITE_FORM_ENDPOINT=

# Dirección o ciudad visible en el pie de página
VITE_COMPANY_ADDRESS=

# Redes (URL completa)
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
